<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Action -->
    <record id="paperformat_monthly_payslip" model="report.paperformat">
        <field name="name">Payslip Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">1</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_monthly_payslip_report" model="ir.actions.report">
        <field name="name">Monthly Payslip Report</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bank_advice_letter.monthly_payslip_report_template</field>
        <field name="report_file">bank_advice_letter.monthly_payslip_report_template</field>
        <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_monthly_payslip"/>
    </record>

    <!-- Report Template -->
    <template id="monthly_payslip_report_template">
        <main style="margin:0; padding:0;">
            <style>
                @page {
                    margin: 0 !important;
                    padding: 0 !important;
                }
                body, main, .page, table.payslip-table, tr, td {
                    margin: 0 !important;
                    padding: 0 !important;
                    vertical-align: top;
                }
                table.payslip-table {
                    width: 100%;
                    border-collapse: separate;
                    border-spacing: 20px 24px;
                }
                td.payslip-cell {
                    width: 50%;
                    vertical-align: top;
                    padding: 0;
                }
                .payroll-slip {
                    min-height: 260px;
                    height: 260px;
                    border: 2px solid #000;
                    padding: 0;
                    margin-bottom: 0;
                    box-sizing: border-box;
                    page-break-inside: avoid;
                    position: relative;
                    background: #fff;
                }
                .slip-header {
                    background-color: #87CEEB;
                    padding: 8px;
                    text-align: center;
                    font-weight: bold;
                    border-bottom: 1px solid #000;
                    color: #000;
                }
                .slip-period {
                    background-color: #f0f0f0;
                    padding: 5px 8px;
                    text-align: center;
                    font-size: 12px;
                    border-bottom: 1px solid #000;
                }
                .slip-department {
                    background-color: #f0f0f0;
                    padding: 5px 8px;
                    text-align: center;
                    font-size: 12px;
                    font-weight: bold;
                    border-bottom: 1px solid #000;
                }
                .slip-body {
                    padding: 10px;
                }
                .slip-employee-name {
                    text-align: center;!important
                }    
                .slip-number {
                    background-color: #87CEEB;
                    color: #000;
                    padding: 5px 8px;
                    font-weight: bold;
                    float: left;
                    margin-right: 10px;
                    margin-bottom: 10px;
                    min-width: 30px;
                    text-align: center;
                }
                .employee-name {
                    background-color: #87CEEB;
                    color: #000;
                    padding: 5px 8px;
                    font-weight: bold;
                    margin-bottom: 5px;
                    clear: both;
                }
                .employee-id {
                    font-size: 12px;
                    margin-bottom: 10px;
                    text-align: center;
                }
                .salary-box {
                    border: 2px solid #000;
                    padding: 8px;
                    text-align: center;
                    font-weight: bold;
                    margin: 10px 0;
                    background-color: #f9f9f9;
                }
                .received-by {
                    margin-top: 15px;
                    border-top: 1px solid #ccc;
                    padding-top: 10px;
                    font-size: 12px;
                }
                .signature-line {
                    border-bottom: 1px solid #000;
                    width: 200px;
                    margin-left: 10px;
                    display: inline-block;
                    height: 1px;
                }
                .right-slip {
                    background-color: #f0f8ff;
                }
                .right-slip .slip-header {
                    background-color: #87CEEB;
                }
            </style>
            <t t-set="company" t-value="user.company_id"/>
            <t t-set="total" t-value="len(docs)"/>
            <t t-set="pages" t-value="(total + 3) // 4"/>
            <t t-set="chunks" t-value="[docs[i:i+4] for i in range(0, len(docs), 4)]"/>
            <t t-set="num_chunks" t-value="len(chunks)"/>
            <t t-set="chunk_idx" t-value="0"/>
            <t t-foreach="chunks" t-as="chunk">
                <div class="page" style="margin:0; padding:0;">
                    <table class="payslip-table" style="margin:0; padding:0;">
                        <t t-foreach="range(4)" t-as="i">
                            <tr>
                                <td class="payslip-cell">
                                    <t t-if="i &lt; len(chunk)">
                                        <div class="payroll-slip">
                                            <div style="position:absolute; top:8px; left:8px; z-index:2;">
                                                <!--
                                                <img t-if="company and company.logo" t-att-src="image_data_uri(company.logo)" style="height:28px; width:auto;"/>
                                                -->
                                            </div>
                                            <div style="background-color: #f0f0f0; padding: 5px 8px; border-bottom: 1px solid #fff; display: flex; align-items: center; position: relative;">
                                                <span style="text-align: left; font-size: 12px; font-weight: normal;"> <t t-if="chunk[i].date_from">Period: <t t-esc="chunk[i].date_from.strftime('%b %Y').upper()"/></t> </span>
                                                <span style="font-weight: bold; text-align: center; position: absolute; left: 0; right: 0; margin: auto; width: fit-content;"> Dept: <t t-esc="chunk[i].employee_id.department_id.name or 'Employees'"/></span>
                                            </div>
                                            <div style="background-color: #87CEEB; padding: 5px 8px; border-bottom: 1px solid #fff; display: flex; align-items: center; position: relative;">
                                                <span style="font-weight: bold; text-align: left; flex: 1;">Emp ID: <t t-esc="chunk[i].employee_id.id"/></span>
                                                <span style="font-weight: bold; text-align: center; position: absolute; left: 0; right: 0; margin: auto; width: fit-content;"> <t t-esc="chunk[i].employee_id.name"/></span>
                                            </div>
                                            <div style="width: 100%; text-align: center; font-weight: bold; margin: 2px 0;">
                                                Slip No: <t t-esc="chunk[i].id"/>
                                            </div>
                                            <div class="slip-body">
                                                <div style="margin-bottom: 10px; display: flex; align-items: center; width: 100%;">
                                                    <span style="font-weight:bold; flex: 1; text-align: left;">Worked Hours: <t t-esc="'{:.2f}'.format(chunk[i].sum_worked_hours or 0)"/></span>
                                                    <span style="font-weight:bold; flex: 1; text-align: right;">Extra Hours: <t t-esc="sum([line.number_of_hours for line in chunk[i].worked_days_line_ids if line.code == 'OVERTIME']) if chunk[i].worked_days_line_ids else 0"/></span>
                                                </div>
                                                <div class="salary-box">
                                                    RS<span style="margin-left: 20px;">
                                                        <t t-esc="'{:,.0f}'.format(chunk[i].net_wage)" t-if="chunk[i].net_wage"/>
                                                        <t t-if="not chunk[i].net_wage">0</t>
                                                    </span>
                                                </div>
                                                <div class="received-by">
                                                    Received By: <span style="display:inline-block; border-bottom:1.5px solid #000; width:180px; height:18px; vertical-align:bottom;"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </td>
                                <td class="payslip-cell">
                                    <t t-if="i &lt; len(chunk)">
                                        <div class="payroll-slip">
                                            <div style="position:absolute; top:8px; left:8px; z-index:2;">
                                                <!--
                                                <img t-if="company and company.logo" t-att-src="image_data_uri(company.logo)" style="height:28px; width:auto;"/>
                                                -->
                                                </div>
                                            <div style="background-color: #f0f0f0; padding: 5px 8px; border-bottom: 1px solid #000; display: flex;align-items: center;">
                                                <span style="text-align: left; font-size: 12px; font-weight: normal; "> <t t-if="chunk[i].date_from">Period: <t t-esc="chunk[i].date_from.strftime('%b %Y').upper()"/></t> </span>
                                                <span style="font-weight: bold; text-align: center; position: absolute; left: 0; right: 0; margin: auto; width: fit-content;"> Dept: <t t-esc="chunk[i].employee_id.department_id.name or 'Employees'"/></span>
                                            </div>
                                            <div style="background-color: #87CEEB; padding: 5px 8px; border-bottom: 1px solid #fff; display: flex; align-items: center; position: relative;">
                                                <span style="font-weight: bold; text-align: left; flex: 1;">Emp ID: <t t-esc="chunk[i].employee_id.id"/></span>
                                                <span style="font-weight: bold; text-align: center; position: absolute; left: 0; right: 0; margin: auto; width: fit-content;"> <t t-esc="chunk[i].employee_id.name"/></span>
                                            </div>
                                            <div style="width: 100%; text-align: center; font-weight: bold; margin: 2px 0;">
                                                Slip No: <t t-esc="chunk[i].id"/>
                                            </div>
                                            <div class="slip-body">
                                                <div style=" padding: 5px 8px;  display: flex; align-items: center; position: relative;">
                                                    <span style="text-align:left; font-weight:bold;">Worked Hours: <t t-esc="'{:.2f}'.format(chunk[i].sum_worked_hours or 0)"/></span>
                                                    <span style="text-align:right; font-weight:bold;">Extra Hours: <t t-esc="sum([line.number_of_hours for line in chunk[i].worked_days_line_ids if line.code == 'OVERTIME']) if chunk[i].worked_days_line_ids else 0"/></span>
                                                </div>
                                                <div class="salary-box">
                                                    RS<span style="margin-left: 20px;">
                                                        <t t-esc="'{:,.0f}'.format(chunk[i].net_wage)" t-if="chunk[i].net_wage"/>
                                                        <t t-if="not chunk[i].net_wage">0</t>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </table>
                </div>
                <t t-if="chunk_idx != num_chunks - 1">
                    <div style="page-break-after: always;"></div>
                </t>
                <t t-set="chunk_idx" t-value="chunk_idx + 1"/>
            </t>
        </main>
    </template>
</odoo>