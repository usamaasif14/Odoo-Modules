<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee Bank Account Form View -->
    <record id="view_hr_employee_bank_form" model="ir.ui.view">
        <field name="name">hr.employee.bank.form</field>
        <field name="model">hr.employee.bank</field>
        <field name="arch" type="xml">
            <form string="Employee Bank Account">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="bank_name"/>
                        </group>
                        <group>
                            <field name="account_number"/>
                            <field name="is_primary"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Employee Bank Account List View -->
    <record id="view_hr_employee_bank_list" model="ir.ui.view">
        <field name="name">hr.employee.bank.list</field>
        <field name="model">hr.employee.bank</field>
        <field name="arch" type="xml">
            <list string="Employee Bank Accounts">
                <field name="employee_id"/>
                <field name="bank_name"/>
                <field name="account_number"/>
                <field name="is_primary"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Employee Bank Account Action -->
    <record id="action_hr_employee_bank" model="ir.actions.act_window">
        <field name="name">Employee Bank Accounts</field>
        <field name="res_model">hr.employee.bank</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create employee bank accounts
            </p>
            <p>
                Manage bank account information for employees to generate
                proper advice letters for payroll processing.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_hr_employee_bank"
              name="Employee Banks"
              parent="hr_work_entry_contract_enterprise.menu_hr_payroll_configuration"
              action="action_hr_employee_bank"
              sequence="20"/>

    <!-- Extended Employee Form View -->
    <record id="view_employee_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']/group" position="after">
                <group string="Bank Information">
                    <field name="primary_bank_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>