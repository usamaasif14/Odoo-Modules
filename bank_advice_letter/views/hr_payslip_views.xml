<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add print button to the form view -->
    <record id="view_hr_payslip_form_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.bank.advice</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <!-- Add print button to the form header -->
            <xpath expr="//header/button[@name='action_print_payslip']" position="after">
                <button name="action_print_monthly_payslip" 
                        string="Print Monthly Payslip" 
                        type="object" 
                        class="oe_highlight"
                        groups="hr_payroll.group_hr_payroll_user"/>
            </xpath>
        </field>
    </record>
    
    <!-- Add print button to the tree view -->
    <record id="view_hr_payslip_tree_inherit" model="ir.ui.view">
        <field name="name">hr.payslip.tree.inherit.bank.advice</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_print_payslip']" position="after">
                <button name="action_print_monthly_payslip" 
                        string="Print Monthly" 
                        type="object" 
                        class="oe_highlight"
                        groups="hr_payroll.group_hr_payroll_user"/>
            </xpath>
        </field>
    </record>
</odoo>