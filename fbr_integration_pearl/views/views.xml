<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Product Template Form View -->
        <record id="view_product_template_form_fbr" model="ir.ui.view">
            <field name="name">product.template.form.fbr</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="FBR Details">
                        <group>
                            <group string="Product Classification">
                                <field name="fbr_hs_code_id"/>
                                <field name="pct_code"/>
                                <field name="fbr_uom_id"/>
                                <field name="sale_type"/>
                            </group>
                            <group string="SRO Details">
                                <field name="sro_schedule"/>
                                <field name="sro_item"/>
                            </group>
                        </group>
                        <group>
                            <group string="Tax Configuration">
                                <field name="fed_duty"/>
                                <field name="further_tax"/>
                                <field name="extra_tax"/>
                                <field name="withholding_tax"/>
                                <field name="other_tax"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Partner Form View -->
        <record id="view_partner_form_fbr" model="ir.ui.view">
            <field name="name">res.partner.form.fbr</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="cnic"/>
                    <field name="buyer_registration_type"/>
                </xpath>
            </field>
        </record>

        <!-- Company Form View -->
        <record id="view_company_form_fbr" model="ir.ui.view">
            <field name="name">res.company.form.fbr</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="strn_or_ntn"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>