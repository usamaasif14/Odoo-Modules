<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- FBR Invoice Logs list View -->
        <record id="view_fbr_invoice_logs_list" model="ir.ui.view">
            <field name="name">fbr.invoice.logs.list</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <list string="FBR Invoice Logs" create="false" edit="false">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="invoice_date"/>
                    <field name="amount_total"/>
                    <field name="fbr_status"/>
                    <field name="fbr_invoice_number"/>
                    <field name="fbr_post_successful"/>
                </list>
            </field>
        </record>

        <!-- FBR Invoice Logs Form View -->
        <record id="view_fbr_invoice_logs_form" model="ir.ui.view">
            <field name="name">fbr.invoice.logs.form</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <form string="FBR Invoice Log" create="false" edit="false">
                    <header>
                        <field name="fbr_status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Invoice Details">
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="invoice_date"/>
                                <field name="amount_total"/>
                            </group>
                            <group string="FBR Details">
                                <field name="fbr_invoice_number"/>
                                <field name="fbr_post_successful"/>
                                <field name="scenario_id"/>
                            </group>
                        </group>
                        
                        <group string="QR Code">
                            <field name="fbr_qr_image" widget="image" options="{'size': [300, 300]}"/>
                        </group>
                        
                        <notebook>
                            <page string="FBR Request">
                                <field name="fbr_request" nolabel="1"/>
                            </page>
                            <page string="FBR Response">
                                <field name="fbr_response" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- FBR Invoice Logs Search View -->
        <record id="view_fbr_invoice_logs_search" model="ir.ui.view">
            <field name="name">fbr.invoice.logs.search</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <search string="FBR Invoice Logs">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="fbr_invoice_number"/>
                    <filter string="Sent to FBR" name="sent_to_fbr" domain="[('fbr_status', '!=', 'draft')]"/>
                    <filter string="Verified" name="verified" domain="[('fbr_status', '=', 'verified')]"/>
                    <filter string="Failed" name="failed" domain="[('fbr_status', '=', 'failed')]"/>
                    <filter string="Successful" name="successful" domain="[('fbr_post_successful', '=', True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="FBR Status" name="group_fbr_status" context="{'group_by': 'fbr_status'}"/>
                        <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                        <filter string="Invoice Date" name="group_date" context="{'group_by': 'invoice_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action for FBR Invoice Logs -->
        <record id="action_fbr_invoice_logs" model="ir.actions.act_window">
            <field name="name">FBR Invoice Logs</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_fbr_invoice_logs_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_fbr_invoice_logs_form')})]"/>
            <field name="domain">[('move_type', 'in', ['out_invoice', 'out_refund']), ('fbr_status', '!=', 'draft')]</field>
            <field name="context">{'create': False}</field>
            <field name="search_view_id" ref="view_fbr_invoice_logs_search"/>
        </record>

        <!-- Menu Item for FBR Logs -->
        <menuitem id="menu_fbr_invoice_logs" 
                  name="Invoice Logs" 
                  parent="menu_fbr_main" 
                  action="action_fbr_invoice_logs" 
                  sequence="30"/>

    </data>
</odoo>